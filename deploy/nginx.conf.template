server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    location = /health { default_type text/plain; return 200 'ok'; }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }
    location = /research/ { return 308 /research$is_args$args; }
    location = /research { try_files /index.html =404; }
    location /research/ { try_files $uri =404; }
    location /models/ { try_files $uri =404; }
    location ~ /\. { return 404; }
    location ~ ^/lab/(classical|supervised|move-guided|rl)/?$ { try_files /index.html =404; }
    location = / { try_files /index.html =404; }
    location / { return 404; }
}
