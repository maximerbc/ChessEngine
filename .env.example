# Backend: exact frontend origins; comma-separated for local development.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODEL_MANIFEST=artifacts/models/manifest.json
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
# Frontend: set this in Railway demo service variables (Docker build argument).
# VITE_API_URL=https://your-chessengine-api.up.railway.app
# Production API images set this to 1; local development may omit it.
REQUIRE_MODELS=0
