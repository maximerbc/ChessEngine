  },
  "regularization": [
    {"name": "weaker-decay", "weight_decay": 0.00001, "dropout": 0},
    {"name": "stronger-decay", "weight_decay": 0.001, "dropout": 0},
    {"name": "dropout-01", "weight_decay": 0.0001, "dropout": 0.1},
    {"name": "dropout-02", "weight_decay": 0.0001, "dropout": 0.2}
