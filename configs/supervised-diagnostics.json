{
  "version": 1,
  "source": "data/main-labeled.jsonl",
  "checkpoint": "artifacts/models/supervised.npz",
  "output": "runs/supervised-diagnostics",
  "subset_sizes": [10000, 40000, "all"],
  "sampling_seed": 2026,
  "seeds": [42, 43, 44],
  "bootstrap_resamples": 2000,
